import { createClient } from '@supabase/supabase-js'

// Configuración de Supabase usando variables de entorno
const supabaseUrl = process.env.EXPO_PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL || ''
const supabaseAnonKey = process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY || ''

if (!supabaseUrl || !supabaseAnonKey) {
  throw new Error('Las variables de entorno SUPABASE_URL y SUPABASE_ANON_KEY son requeridas')
}

export const supabase = createClient(supabaseUrl, supabaseAnonKey)

// Tipos para TypeScript basados en la lógica de api-expo

// Enums
export type TipoGasto = 'personal' | 'compartido'
export type MedioPago = 'efectivo' | 'transferencia'

// Interfaces principales
export interface Usuario {
  id: string
  username: string
  email: string
  first_name?: string
  last_name?: string
  is_active: boolean
  is_verified: boolean
  rol: string
  provider?: string
  provider_id?: string
  foto_url?: string
  created_at: string
  updated_at: string
}

export interface Participante {
  id: string
  email?: string
  nickname: string
  usuario_id?: string
  es_registrado: boolean
  created_at: string
  updated_at: string
  // Relaciones
  usuario?: Usuario
}

export interface Gasto {
  id: string
  descripcion?: string
  monto_total: number
  tipo: TipoGasto
  cuotas: number
  descuento?: number
  fecha: string
  usuario_id: string
  created_at: string
  // Relaciones
  usuario?: Usuario
  detalles?: GastoDetalle[]
}

export interface GastoDetalle {
  id: string
  gasto_id: string
  participante_id: string
  monto: number
  pagado: boolean
  saldo?: number
  vencimiento?: string
  numero_cuota: number
  created_at: string
  // Relaciones
  gasto?: Gasto
  participante?: Participante
  pago?: Pago
}

export interface Pago {
  id: string
  gasto_detalle_id: string
  monto: number
  medio_pago: MedioPago
  fecha_pago: string
  descripcion?: string
  comprobante_url?: string
  created_at: string
  // Relaciones
  gasto_detalle?: GastoDetalle
}

// Interfaces para crear entidades
export interface GastoCreate {
  descripcion?: string
  monto_total: number
  tipo: TipoGasto
  cuotas: number
  descuento?: number
  fecha: string
  usuario_id: string
  participantes: ParticipanteCreate[]
  primer_vencimiento: string
  pagado?: boolean
}

export interface ParticipanteCreate {
  nickname: string
  email?: string
  usuario_id?: string
  monto_total: number
}

export interface GastoDetalleCreate {
  gasto_id: string
  participante_id: string
  monto: number
  pagado?: boolean
  saldo?: number
  vencimiento?: string
  numero_cuota?: number
}

export interface PagoCreate {
  gasto_detalle_id: string
  monto: number
  medio_pago: MedioPago
  fecha_pago: string
  descripcion?: string
  comprobante_url?: string
}

// Interfaces para IOUs
export interface IOU {
  id: string
  acreedor_id: string
  deudor_id: string
  monto: number
  descripcion?: string
  fecha_creacion: string
  fecha_vencimiento?: string
  estado: 'pendiente' | 'pagado' | 'cancelado'
  gasto_origen_id?: string
  created_at: string
  updated_at: string
  // Relaciones
  acreedor?: Participante
  deudor?: Participante
  gasto_origen?: Gasto
  pagos?: PagoIOU[]
}

export interface IOUCreate {
  acreedor_id: string
  deudor_id: string
  monto: number
  descripcion?: string
  fecha_vencimiento?: string
  gasto_origen_id?: string
}

export interface PagoIOU {
  id: string
  iou_id: string
  monto: number
  medio_pago: MedioPago
  fecha_pago: string
  descripcion?: string
  comprobante_url?: string
  created_at: string
  // Relaciones
  iou?: IOU
}

export interface PagoIOUCreate {
  iou_id: string
  monto: number
  medio_pago: MedioPago
  fecha_pago: string
  descripcion?: string
  comprobante_url?: string
}

export interface ResumenIOUParticipante {
  participante_id: string
  nickname: string
  email?: string
  total_por_cobrar: number
  ious_por_cobrar: number
  total_por_pagar: number
  ious_por_pagar: number
  balance_neto: number
}

// Funciones de utilidad para trabajar con Supabase
export const gastosService = {
  // Obtener gastos del usuario
  async obtenerGastos(userId: string) {
    const { data, error } = await supabase
      .from('gastos')
      .select(`
        *,
        usuario:usuarios(*),
        detalles:gastos_detalle(
          *,
          participante:participantes(*),
          pago:pagos(*)
        )
      `)
      .eq('usuario_id', userId)
      .order('created_at', { ascending: false })
    
    if (error) throw error
    
    // Asegurar que detalles siempre sea un array
    const gastosConDetalles = (data || []).map(gasto => ({
      ...gasto,
      detalles: gasto.detalles || []
    }))
    
    return gastosConDetalles as Gasto[]
  },

  // Crear gasto completo con lógica de api-gastos
  async crearGastoCompleto(gastoData: GastoCreate, userId: string) {
    console.log('=== INICIO crearGastoCompleto ===');
    console.log('Datos del gasto recibidos:', JSON.stringify(gastoData, null, 2));
    console.log('Usuario ID:', userId);
    
    // Calcular monto total
    const montoTotal = gastoData.participantes.reduce((sum, p) => sum + p.monto_total, 0)
    console.log('Monto total calculado:', montoTotal);

    // Crear el gasto principal
    const gastoInsert = {
      descripcion: gastoData.descripcion,
      monto_total: montoTotal,
      tipo: gastoData.tipo,
      cuotas: gastoData.cuotas || 1,
      descuento: gastoData.descuento,
      fecha: gastoData.primer_vencimiento,
      usuario_id: userId
    };
    console.log('Datos a insertar en tabla gastos:', JSON.stringify(gastoInsert, null, 2));
    
    const { data: gasto, error: gastoError } = await supabase
      .from('gastos')
      .insert(gastoInsert)
      .select()
      .single()

    if (gastoError) {
      console.error('Error al crear gasto:', gastoError);
      throw gastoError;
    }
    
    console.log('Gasto creado exitosamente:', gasto);

    // Crear o obtener participantes
    const participantesCreados = []
    for (const p of gastoData.participantes) {
      const participante = await participantesService.obtenerOCrearParticipante(p)
      participantesCreados.push({ participante, monto: p.monto_total })
    }

    // Crear detalles según el tipo de gasto
    console.log('Procesando detalles del gasto. Tipo:', gastoData.tipo);
    if (gastoData.tipo === 'personal') {
      await this.procesarGastoPersonal(gasto.id, gastoData, participantesCreados)
    } else {
      await this.procesarGastoCompartido(gasto.id, gastoData, participantesCreados)
    }

    console.log('=== FIN crearGastoCompleto - Gasto creado exitosamente ===');
    return gasto
  },

  // Procesar gasto personal
  async procesarGastoPersonal(gastoId: string, gastoData: GastoCreate, participantesCreados: any[]) {
    const { participante, monto } = participantesCreados[0]
    
    if ((gastoData.cuotas || 1) === 1) {
      // Caso 1: Gasto personal en un pago
      const { data: detalle, error } = await supabase
        .from('gastos_detalle')
        .insert({
          gasto_id: gastoId,
          participante_id: participante.id,
          monto: monto,
          numero_cuota: 1,
          vencimiento: gastoData.primer_vencimiento
        })
        .select()
        .single()
      
      if (error) throw error
      
      // Si está marcado como pagado, crear el pago
      if (gastoData.pagado) {
        await supabase
          .from('pagos')
          .insert({
            gasto_detalle_id: detalle.id,
            monto: monto,
            medio_pago: 'efectivo',
            fecha_pago: gastoData.primer_vencimiento
          })
      }
    } else {
      // Casos 2 y 3: Gasto personal en cuotas
      const descuentoTotal = gastoData.descuento || 0
      const montoPorCuota = monto / (gastoData.cuotas || 1)
      let descuentoRestante = descuentoTotal
      
      for (let i = 0; i < (gastoData.cuotas || 1); i++) {
        let montoCuota = montoPorCuota
        
        if (descuentoRestante >= montoPorCuota) {
          montoCuota = 0
          descuentoRestante -= montoPorCuota
        } else if (descuentoRestante > 0) {
          montoCuota = montoPorCuota - descuentoRestante
          descuentoRestante = 0
        }
        
        const fechaVencimiento = new Date(gastoData.primer_vencimiento)
        fechaVencimiento.setMonth(fechaVencimiento.getMonth() + i)
        
        const { error } = await supabase
          .from('gastos_detalle')
          .insert({
            gasto_id: gastoId,
            participante_id: participante.id,
            monto: Math.round(montoCuota * 100) / 100,
            numero_cuota: i + 1,
            vencimiento: fechaVencimiento.toISOString().split('T')[0]
          })
        
        if (error) throw error
      }
    }
  },

  // Procesar gasto compartido
  async procesarGastoCompartido(gastoId: string, gastoData: GastoCreate, participantesCreados: any[]) {
    console.log('=== INICIO procesarGastoCompartido ===');
    console.log('Gasto ID:', gastoId);
    console.log('Participantes creados:', JSON.stringify(participantesCreados, null, 2));
    
    // Para gastos compartidos, obtenemos el monto total del gasto creado
    const { data: gasto, error: gastoError } = await supabase
      .from('gastos')
      .select('monto_total')
      .eq('id', gastoId)
      .single()
    
    if (gastoError) throw gastoError
    
    const montoTotalGasto = gasto.monto_total
    console.log('Monto total del gasto:', montoTotalGasto);
    
    if ((gastoData.cuotas || 1) === 1) {
      // Caso 4: Gasto compartido en un pago
      const montoEquitativo = montoTotalGasto / participantesCreados.length
      console.log('Monto equitativo por participante:', montoEquitativo);
      
      // Preparar todos los detalles para insertar en una sola operación
      const detallesParaInsertar = participantesCreados.map(({ participante, monto: aporte }) => {
        // Nueva lógica del saldo:
        // - Para participantes que aportan: saldo = aporte inicial, se descuenta con pagos hasta igualar monto
        // - Para participantes que no aportan: saldo = 0, se suma con pagos hasta igualar monto
        const saldo = aporte
        
        // Se marca como pagado cuando:
        // - Si aportó: cuando el saldo es igual al monto (ya pagó su parte)
        // - Si no aportó: cuando el saldo es igual al monto (recibió pagos suficientes)
        const pagado = Math.abs(saldo - montoEquitativo) < 0.01
        
        const detalleInsert = {
          gasto_id: gastoId,
          participante_id: participante.id,
          monto: Math.round(montoEquitativo * 100) / 100,
          saldo: Math.round(saldo * 100) / 100,
          pagado: pagado,
          numero_cuota: 1,
          vencimiento: gastoData.primer_vencimiento
        };
        
        console.log(`Preparando detalle para participante ${participante.nickname}:`, JSON.stringify(detalleInsert, null, 2));
        console.log(`Lógica: aporte=${aporte}, monto_equitativo=${montoEquitativo}, saldo_inicial=${saldo}, pagado=${pagado}`);
        
        return detalleInsert;
      });
      
      // Insertar todos los detalles en una sola operación para evitar problemas con el trigger de validación
      console.log('Insertando todos los detalles en una operación:', JSON.stringify(detallesParaInsertar, null, 2));
      
      const { data: detalles, error } = await supabase
        .from('gastos_detalle')
        .insert(detallesParaInsertar)
        .select()
      
      if (error) {
        console.error('Error al insertar gastos_detalle:', error);
        throw error;
      }
      
      console.log('Todos los detalles creados exitosamente:', detalles);
      
      // No crear pagos automáticos aquí - se manejarán manualmente según la nueva lógica
      // Los pagos se registrarán por separado y actualizarán el saldo según corresponda
    } else {
      // Casos 5 y 6: Gasto compartido en cuotas
      const montoPorParticipante = montoTotalGasto / participantesCreados.length
      const descuentoTotal = gastoData.descuento || 0
      const descuentoPorParticipante = descuentoTotal / participantesCreados.length
      
      console.log('Monto por participante para cuotas:', montoPorParticipante);
      
      for (const { participante } of participantesCreados) {
        await this.generarCuotasCompartidas(
          gastoId,
          participante.id,
          montoPorParticipante,
          descuentoPorParticipante,
          gastoData.cuotas || 1,
          gastoData.primer_vencimiento
        )
      }
    }
  },

  // Generar cuotas para gastos compartidos
  async generarCuotasCompartidas(
    gastoId: string,
    participanteId: string,
    montoPorParticipante: number,
    descuentoPorParticipante: number,
    cuotas: number,
    primerVencimiento: string
  ) {
    console.log('=== INICIO generarCuotasCompartidas ===');
    console.log('Parámetros:', {
      gastoId,
      participanteId,
      montoPorParticipante,
      descuentoPorParticipante,
      cuotas,
      primerVencimiento
    });
    
    const montoPorCuota = montoPorParticipante / cuotas
    let descuentoRestante = descuentoPorParticipante
    console.log('Monto por cuota base:', montoPorCuota);
    console.log('Descuento restante inicial:', descuentoRestante);
    
    for (let i = 0; i < cuotas; i++) {
      let montoCuota = montoPorCuota
      
      if (descuentoRestante >= montoPorCuota) {
        montoCuota = 0
        descuentoRestante -= montoPorCuota
      } else if (descuentoRestante > 0) {
        montoCuota = montoPorCuota - descuentoRestante
        descuentoRestante = 0
      }
      
      const fechaVencimiento = new Date(primerVencimiento)
      fechaVencimiento.setMonth(fechaVencimiento.getMonth() + i)
      
      const detalleInsert = {
        gasto_id: gastoId,
        participante_id: participanteId,
        monto: Math.round(montoCuota * 100) / 100,
        numero_cuota: i + 1,
        vencimiento: fechaVencimiento.toISOString().split('T')[0]
      };
      console.log(`Insertando cuota ${i + 1}:`, JSON.stringify(detalleInsert, null, 2));
      
      const { error } = await supabase
        .from('gastos_detalle')
        .insert(detalleInsert)
      
      if (error) {
        console.error(`Error al insertar cuota ${i + 1}:`, error);
        throw error;
      }
      
      console.log(`Cuota ${i + 1} creada exitosamente`);
    }
    
    console.log('=== FIN generarCuotasCompartidas ===');
  },

  // Crear gasto (método simplificado para compatibilidad)
  async crearGasto(gasto: GastoCreate, userId: string) {
    return await this.crearGastoCompleto(gasto, userId)
  },

  // Eliminar gasto
  async eliminarGasto(gastoId: string, userId: string) {
    // Verificar que el gasto pertenece al usuario
    const { data: gasto, error: gastoError } = await supabase
      .from('gastos')
      .select('id, usuario_id')
      .eq('id', gastoId)
      .eq('usuario_id', userId)
      .single()
    
    if (gastoError || !gasto) throw new Error('Gasto no encontrado o sin permisos')
    
    // Primero obtener los IDs de gastos_detalle
    const { data: gastosDetalle, error: detalleError } = await supabase
      .from('gastos_detalle')
      .select('id')
      .eq('gasto_id', gastoId)
    
    if (detalleError) throw detalleError
    
    // Si hay detalles, verificar que no hay pagos asociados
    if (gastosDetalle && gastosDetalle.length > 0) {
      const detalleIds = gastosDetalle.map(d => d.id)
      
      const { data: pagos, error: pagosError } = await supabase
        .from('pagos')
        .select('id')
        .in('gasto_detalle_id', detalleIds)
      
      if (pagosError) throw pagosError
      if (pagos && pagos.length > 0) {
        throw new Error('No se puede eliminar un gasto con pagos asociados')
      }
    }
    
    // Eliminar gasto (cascade eliminará detalles)
    const { error } = await supabase
      .from('gastos')
      .delete()
      .eq('id', gastoId)
    
    if (error) throw error
  }
}

export const participantesService = {
  // Obtener o crear participante
  async obtenerOCrearParticipante(participanteData: ParticipanteCreate) {
    let participante
    
    if (participanteData.usuario_id) {
      // Buscar participante existente por usuario_id
      const { data: existente } = await supabase
        .from('participantes')
        .select('*')
        .eq('usuario_id', participanteData.usuario_id)
        .single()
      
      if (existente) {
        participante = existente
      } else {
        // Crear nuevo participante registrado
        const { data: nuevo, error } = await supabase
          .from('participantes')
          .insert({
            nickname: participanteData.nickname,
            email: participanteData.email,
            usuario_id: participanteData.usuario_id,
            es_registrado: true
          })
          .select()
          .single()
        
        if (error) throw error
        participante = nuevo
      }
    } else {
      // Buscar participante existente por email o crear nuevo
      let participante_existente = null
      if (participanteData.email) {
        const { data } = await supabase
          .from('participantes')
          .select('*')
          .eq('email', participanteData.email)
          .single()
        participante_existente = data
      }
      
      if (participante_existente) {
        participante = participante_existente
      } else {
        // Crear nuevo participante no registrado
        const { data: nuevo, error } = await supabase
          .from('participantes')
          .insert({
            nickname: participanteData.nickname,
            email: participanteData.email || `${participanteData.nickname.toLowerCase().replace(/\s+/g, '')}@temp.com`,
            es_registrado: false
          })
          .select()
          .single()
        
        if (error) throw error
        participante = nuevo
      }
    }
    
    return participante
  },

  // Obtener todos los participantes
  async obtenerParticipantes() {
    const { data, error } = await supabase
      .from('participantes')
      .select('*')
      .order('nickname')
    
    if (error) throw error
    return data as Participante[]
  }
}

export const pagosService = {
  // Obtener pagos del usuario
  async obtenerPagos(userId: string) {
    console.log('=== INICIO obtenerPagos ===', userId)
    
    try {
      // Consulta simple sin relaciones complejas
      console.log('Obteniendo pagos básicos...')
      const { data, error } = await supabase
        .from('pagos')
        .select('*')
        .order('created_at', { ascending: false })
      
      console.log('Pagos básicos resultado:', typeof data, Array.isArray(data), data?.length || 0)
      
      if (error) {
        console.error('Error obteniendo pagos básicos:', error)
        return []
      }
      
      if (!data) {
        console.log('No hay datos, retornando array vacío')
        return []
      }
      
      console.log('=== FIN obtenerPagos ===', data.length, 'elementos')
      return data
    } catch (error) {
      console.error('Error en obtenerPagos catch:', error)
      console.error('Error stack:', error.stack)
      return []
    }
  },

  // Crear pago
  async crearPago(pago: PagoCreate, userId: string) {
    // Verificar que el gasto detalle pertenece al usuario
    const { data: detalle, error: detalleError } = await supabase
      .from('gastos_detalle')
      .select(`
        *,
        gasto:gastos!inner(usuario_id)
      `)
      .eq('id', pago.gasto_detalle_id)
      .eq('gasto.usuario_id', userId)
      .single()
    
    if (detalleError || !detalle) {
      throw new Error('Gasto detalle no encontrado o sin permisos')
    }
    
    // Crear pago
    const { data, error } = await supabase
      .from('pagos')
      .insert({
        gasto_detalle_id: pago.gasto_detalle_id,
        monto: pago.monto,
        medio_pago: pago.medio_pago,
        fecha_pago: pago.fecha_pago,
        descripcion: pago.descripcion,
        comprobante_url: pago.comprobante_url
      })
      .select()
      .single()
    
    if (error) throw error
    
    // El estado de pagado y saldo se actualizan automáticamente por triggers de BD
    // según la nueva lógica de gastos compartidos
    
    return data as Pago
  },

  // Eliminar pago
  async eliminarPago(pagoId: string, userId: string) {
    // Obtener el pago para verificar permisos y obtener el gasto_detalle_id
    const { data: pago, error: pagoError } = await supabase
      .from('pagos')
      .select(`
        *,
        gasto_detalle:gastos_detalle!inner(
          id,
          gasto:gastos!inner(usuario_id)
        )
      `)
      .eq('id', pagoId)
      .eq('gasto_detalle.gasto.usuario_id', userId)
      .single()
    
    if (pagoError || !pago) {
      throw new Error('Pago no encontrado o sin permisos')
    }
    
    // Eliminar pago
    const { error } = await supabase
      .from('pagos')
      .delete()
      .eq('id', pagoId)
    
    if (error) throw error
    
    // El estado de pagado y saldo se actualizan automáticamente por triggers de BD
    // según la nueva lógica de gastos compartidos
    
    return true
  }
}

export const iouService = {
  // Obtener IOUs del usuario
  async obtenerIOUs(userId: string) {
    console.log('=== INICIO obtenerIOUs ===', userId)
    
    try {
      const { data, error } = await supabase
        .from('ious')
        .select(`
          *,
          acreedor:participantes!acreedor_id(
            id,
            nickname,
            email,
            es_registrado
          ),
          deudor:participantes!deudor_id(
            id,
            nickname,
            email,
            es_registrado
          ),
          gasto_origen:gastos(
            id,
            descripcion,
            monto_total
          ),
          pagos:pagos_iou(
            id,
            monto,
            medio_pago,
            fecha_pago,
            descripcion,
            created_at
          )
        `)
        .order('created_at', { ascending: false })
      
      if (error) {
        console.error('Error obteniendo IOUs:', error)
        return []
      }
      
      console.log('=== FIN obtenerIOUs ===', data?.length || 0, 'elementos')
      return data as IOU[]
    } catch (error) {
      console.error('Error en obtenerIOUs catch:', error)
      return []
    }
  },

  // Crear IOU
  async crearIOU(iou: IOUCreate, userId: string) {
    // Verificar que el usuario tiene permisos para crear el IOU
    // (debe ser el acreedor o tener permisos sobre el gasto origen)
    const { data: acreedorParticipante } = await supabase
      .from('participantes')
      .select('usuario_id')
      .eq('id', iou.acreedor_id)
      .single()
    
    if (acreedorParticipante?.usuario_id !== userId) {
      throw new Error('No tienes permisos para crear este IOU')
    }
    
    // Crear IOU
    const { data, error } = await supabase
      .from('ious')
      .insert({
        acreedor_id: iou.acreedor_id,
        deudor_id: iou.deudor_id,
        monto: iou.monto,
        descripcion: iou.descripcion,
        fecha_vencimiento: iou.fecha_vencimiento,
        gasto_origen_id: iou.gasto_origen_id
      })
      .select()
      .single()
    
    if (error) throw error
    
    return data as IOU
  },

  // Crear pago de IOU
  async crearPagoIOU(pago: PagoIOUCreate, userId: string) {
    // Verificar que el usuario tiene permisos para pagar el IOU
    const { data: iou, error: iouError } = await supabase
      .from('ious')
      .select(`
        *,
        deudor:participantes!deudor_id(usuario_id)
      `)
      .eq('id', pago.iou_id)
      .single()
    
    if (iouError || !iou) {
      throw new Error('IOU no encontrado')
    }
    
    if (iou.deudor?.usuario_id !== userId) {
      throw new Error('No tienes permisos para pagar este IOU')
    }
    
    // Crear pago
    const { data, error } = await supabase
      .from('pagos_iou')
      .insert({
        iou_id: pago.iou_id,
        monto: pago.monto,
        medio_pago: pago.medio_pago,
        fecha_pago: pago.fecha_pago,
        descripcion: pago.descripcion,
        comprobante_url: pago.comprobante_url
      })
      .select()
      .single()
    
    if (error) throw error
    
    // El estado del IOU se actualiza automáticamente por triggers de BD
    
    return data as PagoIOU
  },

  // Eliminar pago de IOU
  async eliminarPagoIOU(pagoId: string, userId: string) {
    // Obtener el pago para verificar permisos
    const { data: pago, error: pagoError } = await supabase
      .from('pagos_iou')
      .select(`
        *,
        iou:ious!inner(
          id,
          deudor:participantes!deudor_id(usuario_id)
        )
      `)
      .eq('id', pagoId)
      .single()
    
    if (pagoError || !pago) {
      throw new Error('Pago no encontrado')
    }
    
    if (pago.iou?.deudor?.usuario_id !== userId) {
      throw new Error('No tienes permisos para eliminar este pago')
    }
    
    // Eliminar pago
    const { error } = await supabase
      .from('pagos_iou')
      .delete()
      .eq('id', pagoId)
    
    if (error) throw error
    
    return true
  },

  // Obtener resumen de IOUs por participante
  async obtenerResumenIOUs(userId: string) {
    try {
      const { data, error } = await supabase
        .from('resumen_ious_participante')
        .select('*')
        .in('participante_id', 
          supabase
            .from('participantes')
            .select('id')
            .eq('usuario_id', userId)
        )
      
      if (error) {
        console.error('Error obteniendo resumen IOUs:', error)
        return []
      }
      
      return data as ResumenIOUParticipante[]
    } catch (error) {
      console.error('Error en obtenerResumenIOUs catch:', error)
      return []
    }
  },

  // Generar IOUs desde gasto compartido
  async generarIOUsDesdeGasto(gastoId: string, userId: string) {
    // Verificar que el usuario es el creador del gasto
    const { data: gasto, error: gastoError } = await supabase
      .from('gastos')
      .select('usuario_id')
      .eq('id', gastoId)
      .single()
    
    if (gastoError || !gasto) {
      throw new Error('Gasto no encontrado')
    }
    
    if (gasto.usuario_id !== userId) {
      throw new Error('No tienes permisos para generar IOUs de este gasto')
    }
    
    // Marcar el gasto para generar IOUs
    const { error: updateError } = await supabase
      .from('gastos')
      .update({ genera_ious: true })
      .eq('id', gastoId)
    
    if (updateError) throw updateError
    
    // Llamar a la función de base de datos para generar IOUs
    const { error: functionError } = await supabase
      .rpc('generar_ious_desde_gasto_compartido', {
        gasto_id_param: gastoId
      })
    
    if (functionError) throw functionError
    
    return true
  },

  // Cancelar IOU
  async cancelarIOU(iouId: string, userId: string) {
    // Verificar permisos (solo el acreedor puede cancelar)
    const { data: iou, error: iouError } = await supabase
      .from('ious')
      .select(`
        *,
        acreedor:participantes!acreedor_id(usuario_id)
      `)
      .eq('id', iouId)
      .single()
    
    if (iouError || !iou) {
      throw new Error('IOU no encontrado')
    }
    
    if (iou.acreedor?.usuario_id !== userId) {
      throw new Error('No tienes permisos para cancelar este IOU')
    }
    
    // Cancelar IOU
    const { error } = await supabase
      .from('ious')
      .update({ estado: 'cancelado' })
      .eq('id', iouId)
    
    if (error) throw error
    
    return true
  }
}