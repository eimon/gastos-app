{
  "expo": {
    "name": "Gastos App",
    "slug": "gastosapp",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gastosapp.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gastosapp.mobile"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-sqlite"
    ],
    "scheme": "gastos-app",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0e85d0f7-38eb-4b3e-ac20-e7d8b1cdbe77"
      }
    },
    "owner": "eim0n"
  }
}
